@model WebApplicationShop.Models.Category

<h1>Удалить категорию</h1>
<p>
    Вы уверены, что хотите удалить категорию <b>«@Model.Name»</b>?
    <br/>
    <small class="text-muted">Товары из этой категории останутся в базе без категории</small>
</p>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Index" class="btn btn-light">Отмена</a>
</form>