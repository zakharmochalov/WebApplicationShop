@model WebApplicationShop.Models.ProductFormViewModel

<h1>Добавить товар</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Product.Name">Название</label>
        <input asp-for="Product.Name" class="form-control" />
        <span asp-validation-for="Product.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Product.Price">Цена</label>
        <input asp-for="Product.Price" class="form-control" />
        <span asp-validation-for="Product.Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Product.Description">Описание</label>
        <textarea asp-for="Product.Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Категории</label>
        @foreach (var cat in Model.AllCategories)
        {
            <div class="form-check">
                <input type="checkbox" name="SelectedCategoryIds" value="@cat.Id"
                       class="form-check-input"
                       @(Model.SelectedCategoryIds.Contains(cat.Id) ? "checked" : "") />
                <label class="form-check-label">@cat.Name</label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Index" class="btn btn-light">Назад</a>
</form>